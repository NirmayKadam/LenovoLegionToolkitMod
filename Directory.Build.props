<Project>
  <PropertyGroup>
    <!-- The one place the version is set. make.bat and the release workflow pass the release version; this is what a
         plain build (Visual Studio, dotnet build, CI) gets, kept at the version being worked on. -->
    <Version>2.36.26.0</Version>
    <FileVersion>2.36.26.0</FileVersion>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <Copyright>© 2026 Nirmay Kadam. Based on Lenovo Legion Toolkit © 2026 Bartosz Cichecki, Kaguya, and Dr. Skinner.</Copyright>
    <Nullable>enable</Nullable>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- Known-vulnerable packages, direct or indirect, are reported at restore; CI builds with warnings as errors. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <BaseOutputPath>$(MSBuildThisFileDirectory)BuildLLT\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)BuildLLT\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
</Project>
