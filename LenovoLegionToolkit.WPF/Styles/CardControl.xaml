<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:custom="clr-namespace:LenovoLegionToolkit.WPF.Controls.Custom"
    xmlns:utils="clr-namespace:LenovoLegionToolkit.WPF.Utils">

    <Style BasedOn="{StaticResource DefaultUiCardControlStyle}" TargetType="{x:Type custom:CardControl}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="utils:Motion.HoverLift" Value="True" />
    </Style>

</ResourceDictionary>