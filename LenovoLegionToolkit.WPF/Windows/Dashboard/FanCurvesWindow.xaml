<local:BaseWindow
    x:Class="LenovoLegionToolkit.WPF.Windows.Dashboard.FanCurvesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:LenovoLegionToolkit.WPF.Controls"
    xmlns:custom="clr-namespace:LenovoLegionToolkit.WPF.Controls.Custom"
    xmlns:local="clr-namespace:LenovoLegionToolkit.WPF.Windows"
    xmlns:resources="clr-namespace:LenovoLegionToolkit.WPF.Resources"
    xmlns:utils="clr-namespace:LenovoLegionToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static resources:Resource.FanCurvesWindow_Title}"
    Width="720"
    MinHeight="0"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <wpfui:TitleBar
            Grid.Row="0"
            CanMaximize="false"
            ShowMaximize="false"
            ShowMinimize="false"
            UseSnapLayout="false" />

        <TextBlock
            Grid.Row="0"
            Margin="12,12,12,8"
            VerticalAlignment="Center"
            FontSize="12"
            IsHitTestVisible="False"
            Text="{x:Static resources:Resource.FanCurvesWindow_Title}" />

        <StackPanel Grid.Row="1" Margin="12,0,12,12">
            <!--  On/off for the whole feature, with what this laptop's firmware does with custom curves.  -->
            <custom:CardControl Margin="0,0,0,8" Icon="WeatherDuststorm24">
                <custom:CardControl.Header>
                    <controls:CardHeaderControl
                        x:Name="_enabledHeader"
                        Title="{x:Static resources:Resource.FanCurvesWindow_Enabled_Title}"
                        Subtitle="{x:Static resources:Resource.FanCurvesWindow_Enabled_Message}"
                        HelpKey="Help_FanCurves" />
                </custom:CardControl.Header>
                <wpfui:ToggleSwitch
                    x:Name="_enabledToggle"
                    AutomationProperties.Name="{x:Static resources:Resource.FanCurvesWindow_Enabled_Title}"
                    Click="EnabledToggle_Click" />
            </custom:CardControl>

            <custom:CardControl Margin="0,0,0,8" Icon="Beaker24">
                <custom:CardControl.Header>
                    <controls:CardHeaderControl
                        x:Name="_supportHeader"
                        Title="{x:Static resources:Resource.FanCurvesWindow_Support_Title}"
                        HelpKey="Help_FanCurves_Test" />
                </custom:CardControl.Header>
                <wpfui:Button
                    x:Name="_testButton"
                    Appearance="Secondary"
                    Click="TestButton_Click"
                    Content="{x:Static resources:Resource.FanCurvesWindow_Test}" />
            </custom:CardControl>

            <!--  The curve for one mode.  -->
            <Grid Margin="0,4,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    x:Name="_modeComboBox"
                    MinWidth="160"
                    AutomationProperties.Name="{x:Static resources:Resource.FanCurvesWindow_Mode}"
                    SelectionChanged="ModeComboBox_SelectionChanged" />
                <CheckBox
                    x:Name="_useCurveCheckBox"
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Content="{x:Static resources:Resource.FanCurvesWindow_UseCurve}" />
            </Grid>

            <TextBlock
                x:Name="_noDataText"
                Margin="0,4,0,8"
                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                Text="{x:Static resources:Resource.FanCurvesWindow_NoData}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <ContentControl x:Name="_editorHost" Margin="0,0,0,8" />

            <!--  Fallback for laptops whose firmware only honours curves in Custom mode.  -->
            <Border
                x:Name="_fallbackPanel"
                Margin="0,0,0,8"
                Padding="12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ControlCornerRadius}"
                Visibility="Collapsed">
                <StackPanel>
                    <TextBlock
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{x:Static resources:Resource.FanCurvesWindow_Fallback_Message}"
                        TextWrapping="Wrap" />
                    <wpfui:Button
                        Margin="0,8,0,0"
                        Appearance="Secondary"
                        Click="CreatePresetButton_Click"
                        Content="{x:Static resources:Resource.FanCurvesWindow_Fallback_Create}" />
                </StackPanel>
            </Border>

            <!--  What is happening now, and what the last action came to.  -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <wpfui:ProgressRing
                    x:Name="_busyRing"
                    Width="16"
                    Height="16"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    IsIndeterminate="False"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="_statusText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    TextWrapping="Wrap" />
            </Grid>

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <wpfui:Button
                    x:Name="_applyNowButton"
                    Margin="0,0,8,0"
                    Appearance="Secondary"
                    Click="ApplyNowButton_Click"
                    Content="{x:Static resources:Resource.FanCurvesWindow_ApplyNow}"
                    ToolTipService.ShowOnDisabled="True" />
                <wpfui:Button
                    x:Name="_saveButton"
                    Margin="0,0,8,0"
                    Appearance="Primary"
                    Click="SaveButton_Click"
                    Content="{x:Static resources:Resource.Save}" />
                <wpfui:Button
                    Appearance="Secondary"
                    Click="CloseButton_Click"
                    Content="{x:Static resources:Resource.Close}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</local:BaseWindow>
