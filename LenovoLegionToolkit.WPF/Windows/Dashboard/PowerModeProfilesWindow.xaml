<local:BaseWindow
    x:Class="LenovoLegionToolkit.WPF.Windows.Dashboard.PowerModeProfilesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:LenovoLegionToolkit.WPF.Controls"
    xmlns:local="clr-namespace:LenovoLegionToolkit.WPF.Windows"
    xmlns:resources="clr-namespace:LenovoLegionToolkit.WPF.Resources"
    xmlns:utils="clr-namespace:LenovoLegionToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static resources:Resource.PowerModeProfiles_Title}"
    Width="600"
    MinWidth="520"
    MinHeight="420"
    MaxWidth="820"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}"
    ResizeMode="CanMinimize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <wpfui:TitleBar
            Grid.Row="0"
            CanMaximize="false"
            ShowMaximize="false"
            ShowMinimize="false"
            UseSnapLayout="false" />

        <TextBlock
            Grid.Row="0"
            Margin="12,12,12,8"
            VerticalAlignment="Center"
            FontSize="12"
            IsHitTestVisible="False"
            Text="{x:Static resources:Resource.PowerModeProfiles_Title}" />

        <!--  One tab per power mode: its fan curve and the Windows power setting LLT uses with it.  -->
        <controls:LoadableControl
            x:Name="_loader"
            Grid.Row="1"
            Margin="12,0,0,0"
            IndicatorVerticalAlignment="Center">
            <wpfui:DynamicScrollViewer>
                <StackPanel Margin="0,0,16,8">
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{x:Static resources:Resource.PowerModeProfiles_Message}"
                        TextWrapping="Wrap" />
                    <TabControl
                        x:Name="_tabControl"
                        Grid.IsSharedSizeScope="True"
                        HorizontalContentAlignment="Center"
                        ItemContainerStyle="{StaticResource SegmentedControlItemStyle}"
                        SelectionChanged="TabControl_SelectionChanged"
                        Style="{StaticResource SegmentedControlStyle}" />
                </StackPanel>
            </wpfui:DynamicScrollViewer>
        </controls:LoadableControl>

        <!--  Apply the shown mode's settings now (only for the mode the laptop is in), and the result.  -->
        <Grid Grid.Row="2" Margin="12,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <controls:UndoBarControl x:Name="_undoBar" Margin="0,0,0,4" />
                <TextBlock
                    x:Name="_statusText"
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <wpfui:Button
                x:Name="_applyNowButton"
                Grid.Column="1"
                Margin="8,0,8,0"
                Appearance="Primary"
                Click="ApplyNowButton_Click"
                Content="{x:Static resources:Resource.PowerModeProfiles_ApplyNow}"
                ToolTipService.ShowOnDisabled="True" />
            <wpfui:Button
                Grid.Column="2"
                Appearance="Secondary"
                Click="CloseButton_Click"
                Content="{x:Static resources:Resource.Close}" />
        </Grid>
    </Grid>
</local:BaseWindow>
