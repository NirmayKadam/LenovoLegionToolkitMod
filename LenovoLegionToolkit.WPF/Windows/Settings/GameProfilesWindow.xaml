<local:BaseWindow
    x:Class="LenovoLegionToolkit.WPF.Windows.Settings.GameProfilesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:LenovoLegionToolkit.WPF.Controls"
    xmlns:custom="clr-namespace:LenovoLegionToolkit.WPF.Controls.Custom"
    xmlns:local="clr-namespace:LenovoLegionToolkit.WPF.Windows"
    xmlns:resources="clr-namespace:LenovoLegionToolkit.WPF.Resources"
    xmlns:utils="clr-namespace:LenovoLegionToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static resources:Resource.GameProfiles_Title}"
    Width="860"
    Height="640"
    MinWidth="720"
    MinHeight="480"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <wpfui:TitleBar
            Grid.Row="0"
            CanMaximize="false"
            ShowMaximize="false"
            ShowMinimize="false"
            UseSnapLayout="false" />

        <TextBlock
            Grid.Row="0"
            Margin="12,12,12,8"
            VerticalAlignment="Center"
            FontSize="12"
            IsHitTestVisible="False"
            Text="{x:Static resources:Resource.GameProfiles_Title}" />

        <Grid Grid.Row="1" Margin="12,0,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  The games.  -->
            <DockPanel Grid.Column="0" Margin="0,0,12,0">
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" Orientation="Horizontal">
                    <wpfui:Button
                        Margin="0,0,8,0"
                        Appearance="Secondary"
                        Click="AddGameButton_Click"
                        Content="{x:Static resources:Resource.GameProfiles_AddGame}"
                        Icon="Add24" />
                    <wpfui:Button
                        x:Name="_removeGameButton"
                        Appearance="Secondary"
                        Click="RemoveGameButton_Click"
                        Content="{x:Static resources:Resource.GameProfiles_RemoveGame}"
                        Icon="Delete24" />
                </StackPanel>
                <ListBox
                    x:Name="_gamesList"
                    AutomationProperties.Name="{x:Static resources:Resource.GameProfiles_Title}"
                    DisplayMemberPath="Name"
                    SelectionChanged="GamesList_SelectionChanged" />
            </DockPanel>

            <!--  The selected game's profile.  -->
            <wpfui:DynamicScrollViewer Grid.Column="1">
                <StackPanel x:Name="_details" Margin="0,0,8,0">
                    <TextBlock
                        x:Name="_noGameText"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{x:Static resources:Resource.GameProfiles_NoGame}"
                        TextWrapping="Wrap" />

                    <StackPanel x:Name="_profilePanel" Visibility="Collapsed">
                        <TextBlock
                            x:Name="_gamePathText"
                            Margin="0,0,0,8"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            TextTrimming="CharacterEllipsis" />

                        <custom:CardControl Margin="0,0,0,8" Icon="Games24">
                            <custom:CardControl.Header>
                                <controls:CardHeaderControl
                                    Title="{x:Static resources:Resource.GameProfiles_Enabled_Title}"
                                    Subtitle="{x:Static resources:Resource.GameProfiles_Enabled_Message}"
                                    HelpKey="Help_GameProfiles_Enabled" />
                            </custom:CardControl.Header>
                            <wpfui:ToggleSwitch
                                x:Name="_enabledToggle"
                                AutomationProperties.Name="{x:Static resources:Resource.GameProfiles_Enabled_Title}"
                                Click="EnabledToggle_Click" />
                        </custom:CardControl>

                        <custom:CardControl Margin="0,0,0,8" Icon="ShieldCheckmark24">
                            <custom:CardControl.Header>
                                <controls:CardHeaderControl
                                    Title="{x:Static resources:Resource.GameProfiles_ForceGameSafe_Title}"
                                    Subtitle="{x:Static resources:Resource.GameProfiles_ForceGameSafe_Message}"
                                    HelpKey="Help_GameProfiles_ForceGameSafe" />
                            </custom:CardControl.Header>
                            <wpfui:ToggleSwitch
                                x:Name="_forceGameSafeToggle"
                                AutomationProperties.Name="{x:Static resources:Resource.GameProfiles_ForceGameSafe_Title}"
                                Click="ForceGameSafeToggle_Click" />
                        </custom:CardControl>

                        <custom:CardControl Margin="0,0,0,8" Icon="Gauge24">
                            <custom:CardControl.Header>
                                <controls:CardHeaderControl
                                    Title="{x:Static resources:Resource.GameProfiles_PowerMode_Title}"
                                    Subtitle="{x:Static resources:Resource.GameProfiles_PowerMode_Message}"
                                    HelpKey="Help_GameProfiles_PowerMode" />
                            </custom:CardControl.Header>
                            <ComboBox
                                x:Name="_powerModeComboBox"
                                MinWidth="160"
                                AutomationProperties.Name="{x:Static resources:Resource.GameProfiles_PowerMode_Title}"
                                DisplayMemberPath="Name"
                                SelectionChanged="PowerModeComboBox_SelectionChanged" />
                        </custom:CardControl>

                        <custom:CardControl Margin="0,0,0,8" Icon="LeafOne24">
                            <custom:CardControl.Header>
                                <controls:CardHeaderControl
                                    Title="{x:Static resources:Resource.GameProfiles_Ease_Title}"
                                    Subtitle="{x:Static resources:Resource.GameProfiles_Ease_Message}"
                                    HelpKey="Help_GameProfiles_Ease" />
                            </custom:CardControl.Header>
                            <wpfui:Button
                                x:Name="_addEaseButton"
                                Appearance="Secondary"
                                Click="AddEaseButton_Click"
                                Content="{x:Static resources:Resource.GameProfiles_AddApp}"
                                Icon="Add24" />
                        </custom:CardControl>
                        <WrapPanel x:Name="_easeList" Margin="0,0,0,12" />

                        <custom:CardControl Margin="0,0,0,8" Icon="Dismiss24">
                            <custom:CardControl.Header>
                                <controls:CardHeaderControl
                                    Title="{x:Static resources:Resource.GameProfiles_Close_Title}"
                                    Subtitle="{x:Static resources:Resource.GameProfiles_Close_Message}"
                                    HelpKey="Help_GameProfiles_Close" />
                            </custom:CardControl.Header>
                            <wpfui:Button
                                x:Name="_addCloseButton"
                                Appearance="Secondary"
                                Click="AddCloseButton_Click"
                                Content="{x:Static resources:Resource.GameProfiles_AddApp}"
                                Icon="Add24" />
                        </custom:CardControl>
                        <WrapPanel x:Name="_closeList" Margin="0,0,0,12" />

                        <custom:CardControl Margin="0,0,0,8" Icon="PauseCircle24">
                            <custom:CardControl.Header>
                                <controls:CardHeaderControl
                                    Title="{x:Static resources:Resource.GameProfiles_Services_Title}"
                                    Subtitle="{x:Static resources:Resource.GameProfiles_Services_Message}"
                                    HelpKey="Help_GameProfiles_Services" />
                            </custom:CardControl.Header>
                            <wpfui:Button
                                x:Name="_addServiceButton"
                                Appearance="Secondary"
                                Click="AddServiceButton_Click"
                                Content="{x:Static resources:Resource.GameProfiles_AddService}"
                                Icon="Add24" />
                        </custom:CardControl>
                        <WrapPanel x:Name="_serviceList" Margin="0,0,0,12" />
                    </StackPanel>
                </StackPanel>
            </wpfui:DynamicScrollViewer>
        </Grid>

        <!--  What is in effect now, and the last apply or put-back.  -->
        <Grid Grid.Row="2" Margin="12,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="_statusText"
                VerticalAlignment="Center"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
            <wpfui:Button
                Grid.Column="1"
                Margin="8,0,0,0"
                Appearance="Secondary"
                Click="CloseButton_Click"
                Content="{x:Static resources:Resource.Close}" />
        </Grid>
    </Grid>
</local:BaseWindow>
