<local:BaseWindow
    x:Class="LenovoLegionToolkit.WPF.Windows.Settings.BackgroundServicesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:LenovoLegionToolkit.WPF.Windows"
    xmlns:resources="clr-namespace:LenovoLegionToolkit.WPF.Resources"
    xmlns:utils="clr-namespace:LenovoLegionToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static resources:Resource.BackgroundServices_Title}"
    Width="760"
    Height="680"
    MinWidth="560"
    MinHeight="420"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <wpfui:TitleBar
            Grid.Row="0"
            CanMaximize="false"
            ShowMaximize="false"
            ShowMinimize="false"
            UseSnapLayout="false" />

        <TextBlock
            Grid.Row="0"
            Margin="12,12,12,8"
            VerticalAlignment="Center"
            FontSize="12"
            IsHitTestVisible="False"
            Text="{x:Static resources:Resource.BackgroundServices_Title}" />

        <ScrollViewer
            Grid.Row="1"
            Margin="16,4,4,0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,8">
                <TextBlock
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{x:Static resources:Resource.BackgroundServices_Message}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,6,0,12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    FontStyle="Italic"
                    Text="{x:Static resources:Resource.ServicePreset_Effect}"
                    TextWrapping="Wrap" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{x:Static resources:Resource.BackgroundServices_Enabled}"
                        TextWrapping="Wrap" />
                    <wpfui:ToggleSwitch
                        x:Name="_enabledToggle"
                        Grid.Column="1"
                        AutomationProperties.Name="{x:Static resources:Resource.BackgroundServices_Enabled}" />
                </Grid>

                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="{x:Static resources:Resource.BackgroundServices_Presets}" />
                <StackPanel x:Name="_presetsPanel" />

                <TextBlock
                    Margin="0,16,0,6"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="{x:Static resources:Resource.BackgroundServices_Status}" />
                <StackPanel x:Name="_statusPanel" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="16,12,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="_statusText"
                VerticalAlignment="Center"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
            <wpfui:Button
                x:Name="_restoreButton"
                Grid.Column="1"
                Margin="8,0,8,0"
                Appearance="Secondary"
                Click="RestoreButton_Click"
                Content="{x:Static resources:Resource.BackgroundServices_RestoreAll}"
                ToolTip="{x:Static resources:Resource.BackgroundServices_RestoreAll_Tooltip}" />
            <wpfui:Button
                x:Name="_applyButton"
                Grid.Column="2"
                Margin="0,0,8,0"
                Appearance="Primary"
                Click="ApplyButton_Click"
                Content="{x:Static resources:Resource.BackgroundServices_Apply}" />
            <wpfui:Button
                Grid.Column="3"
                Appearance="Secondary"
                Click="CloseButton_Click"
                Content="{x:Static resources:Resource.Close}" />
        </Grid>
    </Grid>
</local:BaseWindow>
