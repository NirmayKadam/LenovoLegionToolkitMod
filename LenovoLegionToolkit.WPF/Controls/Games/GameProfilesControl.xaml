<controls:AbstractRefreshingControl
    x:Class="LenovoLegionToolkit.WPF.Controls.Games.GameProfilesControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:LenovoLegionToolkit.WPF.Controls"
    xmlns:custom="clr-namespace:LenovoLegionToolkit.WPF.Controls.Custom"
    xmlns:resources="clr-namespace:LenovoLegionToolkit.WPF.Resources"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml">
    <custom:CardControl Margin="0,0,0,8" Icon="Games24">
        <custom:CardControl.Header>
            <controls:CardHeaderControl
                x:Name="_cardHeader"
                Title="{x:Static resources:Resource.GameProfiles_Title}"
                HelpKey="Help_Settings_GameProfiles"
                Subtitle="{x:Static resources:Resource.SettingsPage_GameProfiles_Message}" />
        </custom:CardControl.Header>
        <wpfui:Button
            Appearance="Secondary"
            AutomationProperties.Name="{x:Static resources:Resource.GameProfiles_Title}"
            Click="OpenButton_Click"
            Content="{x:Static resources:Resource.SettingsPage_FanCurves_Open}" />
    </custom:CardControl>
</controls:AbstractRefreshingControl>
