<controls:AbstractRefreshingControl
    x:Class="LenovoLegionToolkit.WPF.Controls.Games.GameDetectionControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:LenovoLegionToolkit.WPF.Controls"
    xmlns:custom="clr-namespace:LenovoLegionToolkit.WPF.Controls.Custom"
    xmlns:resources="clr-namespace:LenovoLegionToolkit.WPF.Resources"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml">
    <custom:CardControl Margin="0,0,0,8" Icon="Games24">
        <custom:CardControl.Header>
            <controls:CardHeaderControl
                Title="{x:Static resources:Resource.AutomationPage_Game_Detection_Title}"
                HelpKey="Help_Settings_GameDetection"
                Subtitle="{x:Static resources:Resource.AutomationPage_Game_Detection_Sub_Title}" />
        </custom:CardControl.Header>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Name="_modeComboBox"
                Grid.Column="0"
                MinWidth="160"
                Margin="0,0,8,0"
                AutomationProperties.Name="{x:Static resources:Resource.AutomationPage_Game_Detection_Title}"
                SelectionChanged="ModeComboBox_SelectionChanged" />
            <wpfui:Button
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.Name="{x:Static resources:Resource.SettingsPage_ExcludeProcesses_Title}"
                Click="ExcludeProcesses_Click"
                FontSize="20"
                Icon="Settings24"
                ToolTip="{x:Static resources:Resource.SettingsPage_ExcludeProcesses_Title}" />
        </Grid>
    </custom:CardControl>
</controls:AbstractRefreshingControl>
