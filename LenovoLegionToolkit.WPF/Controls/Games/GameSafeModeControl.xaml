<controls:AbstractRefreshingControl
    x:Class="LenovoLegionToolkit.WPF.Controls.Games.GameSafeModeControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:LenovoLegionToolkit.WPF.Controls"
    xmlns:custom="clr-namespace:LenovoLegionToolkit.WPF.Controls.Custom"
    xmlns:resources="clr-namespace:LenovoLegionToolkit.WPF.Resources"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml">
    <custom:CardControl Margin="0,0,0,8" Icon="ShieldCheckmark24">
        <custom:CardControl.Header>
            <controls:CardHeaderControl
                x:Name="_cardHeader"
                Title="{x:Static resources:Resource.SettingsPage_GameSafeMode_Title}"
                HelpKey="Help_Settings_GameSafeMode"
                Subtitle="{x:Static resources:Resource.SettingsPage_GameSafeMode_Message}" />
        </custom:CardControl.Header>
        <wpfui:ToggleSwitch
            x:Name="_toggle"
            AutomationProperties.Name="{x:Static resources:Resource.SettingsPage_GameSafeMode_Title}"
            Click="Toggle_Click" />
    </custom:CardControl>
</controls:AbstractRefreshingControl>
