<UserControl
    x:Class="LenovoLegionToolkit.WPF.Controls.Dashboard.ActiveNowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="clr-namespace:LenovoLegionToolkit.WPF.Resources">

    <!--  Hidden while nothing is going on in the background.  -->
    <StackPanel
        x:Name="_root"
        Margin="0,0,8,8"
        Visibility="Collapsed">
        <TextBlock
            Margin="0,0,0,6"
            FontSize="12"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{x:Static resources:Resource.ActiveNow_Label}" />
        <ItemsControl
            x:Name="_chips"
            AutomationProperties.Name="{x:Static resources:Resource.ActiveNow_Label}"
            Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border
                        Margin="0,0,6,6"
                        Padding="10,4,10,4"
                        AutomationProperties.HelpText="{Binding ToolTip}"
                        AutomationProperties.Name="{Binding Text}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Focusable="True"
                        ToolTip="{Binding ToolTip}">
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding Text}" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
