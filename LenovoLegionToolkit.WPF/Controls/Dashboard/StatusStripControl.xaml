<UserControl
    x:Class="LenovoLegionToolkit.WPF.Controls.Dashboard.StatusStripControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="clr-namespace:LenovoLegionToolkit.WPF.Resources">
    <UserControl.Resources>
        <Style x:Key="TileStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="14,12,14,12" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="Focusable" Value="True" />
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="{DynamicResource LltNumberFontFamily}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Text" Value="—" />
        </Style>
        <Style x:Key="SubStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Text" Value="—" />
        </Style>
        <Style x:Key="TrackStyle" TargetType="Border">
            <Setter Property="Height" Value="3" />
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="CornerRadius" Value="1.5" />
            <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <!--  Retro: the bar drawn as block characters instead.  -->
        <Style x:Key="BlocksStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="{DynamicResource LltNumberFontFamily}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Style x:Key="BarStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="1.5" />
            <Setter Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
        </Style>
    </UserControl.Resources>

    <UniformGrid x:Name="_grid" Columns="5">
        <!--  Power mode  -->
        <Border x:Name="_powerTile" Style="{StaticResource TileStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource LabelStyle}" Text="{x:Static resources:Resource.StatusStrip_Power}" />
                <StackPanel Orientation="Horizontal">
                    <Ellipse
                        x:Name="_powerDot"
                        Width="8"
                        Height="8"
                        Margin="0,6,8,0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                    <TextBlock x:Name="_powerValue" Style="{StaticResource ValueStyle}" />
                </StackPanel>
                <TextBlock x:Name="_powerSub" Style="{StaticResource SubStyle}" />
                <Border Style="{StaticResource TrackStyle}">
                    <Border x:Name="_powerBar" Style="{StaticResource BarStyle}" />
                </Border>
                <TextBlock x:Name="_powerBlocks" Style="{StaticResource BlocksStyle}" />
            </StackPanel>
        </Border>

        <!--  CPU  -->
        <Border x:Name="_cpuTile" Style="{StaticResource TileStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource LabelStyle}" Text="{x:Static resources:Resource.StatusStrip_Cpu}" />
                <TextBlock x:Name="_cpuValue" Style="{StaticResource ValueStyle}" />
                <TextBlock x:Name="_cpuSub" Style="{StaticResource SubStyle}" />
                <Border Style="{StaticResource TrackStyle}">
                    <Border x:Name="_cpuBar" Style="{StaticResource BarStyle}" />
                </Border>
                <TextBlock x:Name="_cpuBlocks" Style="{StaticResource BlocksStyle}" />
            </StackPanel>
        </Border>

        <!--  GPU  -->
        <Border x:Name="_gpuTile" Style="{StaticResource TileStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource LabelStyle}" Text="{x:Static resources:Resource.StatusStrip_Gpu}" />
                <TextBlock x:Name="_gpuValue" Style="{StaticResource ValueStyle}" />
                <TextBlock x:Name="_gpuSub" Style="{StaticResource SubStyle}" />
                <Border Style="{StaticResource TrackStyle}">
                    <Border x:Name="_gpuBar" Style="{StaticResource BarStyle}" />
                </Border>
                <TextBlock x:Name="_gpuBlocks" Style="{StaticResource BlocksStyle}" />
            </StackPanel>
        </Border>

        <!--  Fans  -->
        <Border x:Name="_fanTile" Style="{StaticResource TileStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource LabelStyle}" Text="{x:Static resources:Resource.StatusStrip_Fans}" />
                <TextBlock x:Name="_fanValue" Style="{StaticResource ValueStyle}" />
                <TextBlock x:Name="_fanSub" Style="{StaticResource SubStyle}" />
                <Border Style="{StaticResource TrackStyle}">
                    <Border x:Name="_fanBar" Style="{StaticResource BarStyle}" />
                </Border>
                <TextBlock x:Name="_fanBlocks" Style="{StaticResource BlocksStyle}" />
            </StackPanel>
        </Border>

        <!--  Battery  -->
        <Border x:Name="_batteryTile" Style="{StaticResource TileStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource LabelStyle}" Text="{x:Static resources:Resource.StatusStrip_Battery}" />
                <TextBlock x:Name="_batteryValue" Style="{StaticResource ValueStyle}" />
                <TextBlock x:Name="_batterySub" Style="{StaticResource SubStyle}" />
                <Border Style="{StaticResource TrackStyle}">
                    <Border x:Name="_batteryBar" Style="{StaticResource BarStyle}" Background="{DynamicResource SystemFillColorSuccessBrush}" />
                </Border>
                <TextBlock x:Name="_batteryBlocks" Style="{StaticResource BlocksStyle}" />
            </StackPanel>
        </Border>
    </UniformGrid>
</UserControl>
