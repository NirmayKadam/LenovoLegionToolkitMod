<wpfui:UiPage
    x:Class="LenovoLegionToolkit.WPF.Pages.HealthPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="clr-namespace:LenovoLegionToolkit.WPF.Resources"
    xmlns:utils="clr-namespace:LenovoLegionToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static resources:Resource.Health_Title}"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}"
    Scrollable="True">

    <StackPanel Margin="0,0,16,12">
        <TextBlock
            Margin="0,16,0,8"
            Effect="{DynamicResource LltTextGlowEffect}"
            Focusable="True"
            FontSize="24"
            FontWeight="Medium"
            Text="{x:Static resources:Resource.Health_Title}" />
        <TextBlock
            Margin="0,0,0,16"
            Focusable="True"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{x:Static resources:Resource.Health_Subtitle}"
            TextWrapping="Wrap" />

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <wpfui:Button
                x:Name="_checkNowButton"
                Grid.Column="0"
                MinWidth="120"
                Appearance="Primary"
                AutomationProperties.Name="{x:Static resources:Resource.Health_CheckNow}"
                Click="CheckNowButton_Click"
                Content="{x:Static resources:Resource.Health_CheckNow}"
                Icon="ArrowSync24" />
            <TextBlock
                x:Name="_lastCheckText"
                Grid.Column="1"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Focusable="True"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{x:Static resources:Resource.Health_NotYetChecked}" />
        </Grid>

        <StackPanel x:Name="_itemsPanel" />
    </StackPanel>
</wpfui:UiPage>
